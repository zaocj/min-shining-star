---
const { count = 10 } = Astro.props;
const colors = ['var(--color-wine)', 'var(--color-champagne)', 'var(--color-petal)', 'var(--color-primary)'];
const petals = Array.from({ length: count }, (_, i) => ({
  left: (i * 37 + 17) % 100, size: 10 + (i * 7 + 5) % 14,
  color: colors[i % colors.length], duration: 18 + (i * 5 + 3) % 9,
  delay: -((i * 11 + 9) % 20), sway: (i * 13 + 7) % 44 - 22,
}));
---
<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  {petals.map((p) => <span class="absolute" style={{ left: `${p.left}%`, top: '-30px', color: p.color, fontSize: `${p.size}px`, '--sway': `${p.sway}px`, animation: `ambient-fall ${p.duration}s ease-in-out ${p.delay}s infinite` }}>
    <svg viewBox="0 0 24 24" fill="currentColor" width="1em" height="1em">
      {[0, 60, 120, 180, 240, 300].map((deg) => <ellipse cx="12" cy="5" rx="2.2" ry="4.5" transform={`rotate(${deg} 12 12)`} />)}
      <circle cx="12" cy="12" r="1.8" fill-opacity="0.45" />
    </svg>
  </span>)}
</div>
