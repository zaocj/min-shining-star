---
import { cn } from "../../../../lib/utils";
const { title, dark = false } = Astro.props;
---
<div class="mb-12 flex flex-col items-center gap-3 text-center" data-reveal="">
      <h2 class={cn('text-3xl font-bold tracking-[0.2em] sm:text-4xl', dark ? 'text-cream' : 'text-primary')}>
        {title}
      </h2>
      <div class="mt-1 flex items-center gap-3">
        <span class={cn('h-px w-12', dark ? 'bg-champagne/40' : 'bg-primary/30')}/>
        <span class={cn('text-xs', dark ? 'text-champagne' : 'text-primary')}>❦</span>
        <span class={cn('h-px w-12', dark ? 'bg-champagne/40' : 'bg-primary/30')}/>
      </div>
    </div>
