---
import { cn } from '../../../../lib/utils';
const { role, fullName, avatar, mirrored } = Astro.props;
---
<div class={cn('paper-texture relative flex flex-col items-center gap-3 overflow-hidden rounded-2xl border border-champagne/70 bg-white/70 px-3 py-6 text-center shadow-lg shadow-primary/5', 'sm:gap-5 sm:px-6 sm:py-8 sm:text-left', mirrored ? 'sm:flex-row-reverse sm:text-right' : 'sm:flex-row')} data-reveal="">
      {/* 头像：人物照片裁成圆形，object-position 偏上以保住脸部 */}
      <div class="h-20 w-20 flex-none rounded-full border border-champagne/70 bg-white/60 p-1 sm:h-28 sm:w-28 sm:p-1.5">
        <div class="h-full w-full overflow-hidden rounded-full bg-blush">
          <img src={avatar} alt={fullName} loading="lazy" decoding="async" class="h-full w-full object-cover object-[50%_20%]"/>
        </div>
      </div>

      <div class="min-w-0">
        <p class="text-[10px] tracking-[0.2em] text-gold sm:text-xs sm:tracking-[0.35em]">
          {role}
        </p>
        <h3 class="mt-1.5 text-xl font-bold tracking-[0.15em] text-ink sm:mt-2 sm:text-2xl">
          {fullName}
        </h3>
      </div>
    </div>
