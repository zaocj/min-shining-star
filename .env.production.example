# 部署时复制为 .env.production，替换域名与持久化路径。
NODE_ENV=production
HOST=127.0.0.1
PORT=4321
SITE_URL=https://invitation.example.com
DATABASE_PATH=/var/lib/invitation/app.db

# 公开浏览器 SDK 配置在构建时注入；发布域名须符合高德白名单。
PUBLIC_AMAP_KEY=
PUBLIC_AMAP_SECURITY_CODE=

# 设为 cos 后，相册从 usersphotos/{album_slug}/ 读取；database 保留数据库模式。
GALLERY_SOURCE=database
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_PUBLIC_BASE_URL=https://image.minvitation.site
