# 本地环境：复制为 .env。不要将真实环境配置提交到仓库。
HOST=127.0.0.1
PORT=4321
SITE_URL=http://localhost:4321
DATABASE_PATH=./data/app.db
# 不在本地 .env 固定 NODE_ENV，由 dev/build/start 命令选择运行模式。

# 可选：高德 Web JS SDK 的公开浏览器配置；为空时仍提供导航链接。
PUBLIC_AMAP_KEY=
PUBLIC_AMAP_SECURITY_CODE=

# 相册来源：database 保持原有数据；cos 按 usersphotos/{album_slug}/ 动态列出图片。
GALLERY_SOURCE=database
# 启用 cos 时必填，全部是服务端运行配置，不会发送给浏览器。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
# 图片须可通过该 HTTPS 域名公开读取；只填域名，不含路径。
COS_PUBLIC_BASE_URL=https://image.minvitation.site
