{
  "name": "shining-star",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.11.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "astro dev --background",
    "dev:stop": "astro dev stop",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs",
    "check": "astro check",
    "build": "astro build",
    "start": "NODE_ENV=production node --env-file=.env ./dist/server/entry.mjs",
    "start:production": "node --env-file=.env.production ./dist/server/entry.mjs",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio --host 127.0.0.1",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.13",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "pm2": "^7.1.2",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
