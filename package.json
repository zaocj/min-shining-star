{
  "name": "shining-star",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.11.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "astro dev --background",
    "dev:stop": "astro dev stop",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs",
    "check": "astro check",
    "build": "astro build",
    "start": "NODE_ENV=production node --env-file=.env ./dist/server/entry.mjs",
    "start:production": "node --env-file=.env.production ./dist/server/entry.mjs",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio --host 127.0.0.1",
    "preview": "astro preview",
    "astro": "astro",
    "invitation:import": "node --env-file-if-exists=.env --experimental-strip-types scripts/invitation-import.ts",
    "test": "npm run build && tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.13",
    "@astrojs/react": "^7.1.9",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "better-sqlite3": "^13.2.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.76.0",
    "pm2": "^7.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swiper": "^14.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
